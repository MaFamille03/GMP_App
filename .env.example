# Public Supabase project values (safe for browser use when RLS is correctly configured)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# NEVER expose a Supabase service_role/secret key in NEXT_PUBLIC_* variables.
# Keep any server-only secret outside the browser and only add it when a trusted server task requires it.
